NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0

# Local development example:
# mysql://DB_USER:URL_ENCODED_DB_PASSWORD@localhost:3306/DB_NAME
DATABASE_URL=mysql://DB_USER:URL_ENCODED_DB_PASSWORD@DB_HOST:3306/DB_NAME

# Auth/session configuration.
# Use a generated secret and never commit the real value.
AUTH_SECRET=replace-with-generated-secret
NEXTAUTH_SECRET=replace-with-generated-secret
NEXTAUTH_URL=http://localhost:3000

# Stripe will be required once payments are implemented.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Email/notification settings will be required once notifications are implemented.
EMAIL_FROM=admin@binrun.co.nz
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
