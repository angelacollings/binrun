NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0

# Local development example:
# mysql://DB_USER:URL_ENCODED_DB_PASSWORD@127.0.0.1:3306/DB_NAME
DATABASE_URL=mysql://DB_USER:URL_ENCODED_DB_PASSWORD@DB_HOST:3306/DB_NAME

# Better Auth/session configuration. Required when auth routes are enabled.
# Use generated secrets and never commit the real values.
BETTER_AUTH_SECRET=replace-with-generated-secret
BETTER_AUTH_URL=http://localhost:3000

# Stripe will be required once payments are implemented.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_REGULAR_RUN=price_placeholder_regular_run
STRIPE_PRICE_REGULAR_RUN_PLUS_WASH=price_placeholder_regular_run_plus_wash
STRIPE_PRICE_ONE_OFF_CLEAN=price_placeholder_one_off_clean

# Email/notification settings will be required once notifications are implemented.
EMAIL_FROM=admin@binrun.co.nz
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password

# Do not add NEXT_PUBLIC_ secrets. NEXT_PUBLIC_ values are bundled into browser JavaScript.
